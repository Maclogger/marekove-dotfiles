#!/usr/bin/env python3
"""Set the focused monitor's scale without scrambling a multi-monitor layout.

Omarchy's packaged omarchy-hyprland-monitor-scaling applies scale changes with
position = "auto", which makes Hyprland re-derive every monitor's position from
output order. On a single display that is invisible; with several displays it
reorders them.

This does three things instead:

  1. Applies the requested scale to the focused monitor, cleaned to a value
     Hyprland accepts (the mode must divide into whole logical pixels in 1/120
     steps), using the same algorithm as the packaged script.
  2. Reflows every enabled monitor left to right in their *current* order, so
     the row stays gapless and in the same sequence even though changing scale
     changes logical widths. Each monitor keeps its own y.
  3. Writes the result back to ~/.config/hypr/monitors.lua so it survives a
     reload, a logout, and a reboot.

Usage: omarchy-monitor-scale-keep-layout <scale>
"""

import json
import math
import os
import re
import subprocess
import sys

MONITORS_LUA = os.path.expanduser("~/.config/hypr/monitors.lua")


def run(*args):
    return subprocess.run(args, capture_output=True, text=True, check=True).stdout


def clean_scale(scale, width, height):
    """Round a requested scale up to one Hyprland will accept for this mode."""
    divisor = math.gcd(round(width * 120), round(height * 120))
    units = round(scale * 120)
    if units > divisor:
        units = divisor
    while divisor % units != 0:
        units += 1
    return units / 120


def fmt(value):
    """Format a float for Lua without a trailing .0 or long float noise."""
    text = f"{value:.6f}".rstrip("0").rstrip(".")
    return text or "0"


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: omarchy-monitor-scale-keep-layout <scale>")
    try:
        requested = float(sys.argv[1])
    except ValueError:
        sys.exit(f"not a number: {sys.argv[1]}")
    if not 1 <= requested <= 4:
        sys.exit(f"scale out of range (1-4): {requested}")

    monitors = json.loads(run("hyprctl", "monitors", "-j"))
    if not monitors:
        sys.exit("no enabled monitors")

    focused = next((m for m in monitors if m.get("focused")), monitors[0])
    focused["scale"] = clean_scale(requested, focused["width"], focused["height"])

    # Current left-to-right order is the user's intended order. Reflow within
    # it rather than letting Hyprland re-derive placement from output order.
    row = sorted(monitors, key=lambda m: m["x"])
    cursor = min(m["x"] for m in row)

    for mon in row:
        logical_width = round(mon["width"] / mon["scale"])
        mon["x"] = cursor
        cursor += logical_width

        # A connector name is interpolated into a Lua string below, so keep it
        # to characters that cannot terminate the string or inject code.
        if not re.fullmatch(r"[A-Za-z0-9._-]+", mon["name"]):
            sys.exit(f"refusing unsafe monitor name: {mon['name']!r}")

        mon["_mode"] = f"{mon['width']}x{mon['height']}@{mon['refreshRate']}"
        mon["_pos"] = f"{mon['x']}x{mon['y']}"
        run(
            "hyprctl",
            "eval",
            'hl.monitor({{ output = "{name}", mode = "{mode}", '
            'position = "{pos}", scale = {scale} }})'.format(
                name=mon["name"],
                mode=mon["_mode"],
                pos=mon["_pos"],
                scale=fmt(mon["scale"]),
            ),
        )

    persist(row)


def persist(monitors):
    """Update the hl.monitor() call for each output in monitors.lua.

    Only uncommented calls are touched, so the commented-out alternatives in
    the file (mirroring, rotation) are left exactly as they are.
    """
    if not os.path.exists(MONITORS_LUA):
        return

    with open(MONITORS_LUA) as handle:
        lines = handle.readlines()

    by_name = {m["name"]: m for m in monitors}
    seen = set()

    for index, line in enumerate(lines):
        if line.lstrip().startswith("--"):
            continue
        match = re.search(r'hl\.monitor\(\{\s*output\s*=\s*"([^"]+)"', line)
        if not match:
            continue
        mon = by_name.get(match.group(1))
        if not mon:
            continue
        indent = line[: len(line) - len(line.lstrip())]
        lines[index] = (
            f'{indent}hl.monitor({{ output = "{mon["name"]}", '
            f'mode = "{mon["_mode"]}", position = "{mon["_pos"]}", '
            f'scale = {fmt(mon["scale"])} }})\n'
        )
        seen.add(mon["name"])

    missing = sorted(set(by_name) - seen)
    if missing:
        print(
            "note: no hl.monitor() line in monitors.lua for: " + ", ".join(missing),
            file=sys.stderr,
        )

    with open(MONITORS_LUA, "w") as handle:
        handle.writelines(lines)


if __name__ == "__main__":
    main()
